-- Server-side session storage (server-side-session-storage, design D1/D2).
--
-- One row per live login session. `id` is the opaque cookie token (256-bit
-- SecureRandom, base64url — generated by SqlDelightSessionStorage; Ktor's
-- Sessions plugin only carries it), `payload` is the serialized session flow
-- state (an opaque TEXT blob to this layer), and `expires_at` (epoch millis)
-- is SLIDING: both a read and a write extend it to now + SESSION_TTL_MINUTES,
-- so a read-only browsing/polling pattern never expires an active session.
-- Expired rows are pruned lazily on access and by the background sweep.

CREATE TABLE sessions (
    id TEXT PRIMARY KEY NOT NULL,
    username TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    expires_at INTEGER NOT NULL
);

CREATE INDEX sessions_username_idx ON sessions(username);

-- ---------------------------------------------------------------------------
-- Sessions queries
-- ---------------------------------------------------------------------------

-- Lookup by the opaque cookie token. The wrapped storage additionally checks
-- expires_at and prunes an expired row (lazy pruning on access).
selectSession:
SELECT * FROM sessions WHERE id = ?;

-- Insert-or-replace the row for a token: an unchanged session write refreshes
-- username/payload and the sliding expires_at in one statement (Ktor re-writes
-- the session only when its value changed; the read path renews in between).
writeSession:
INSERT OR REPLACE INTO sessions(id, username, payload, created_at, expires_at)
VALUES (?, ?, ?, ?, ?);

-- Logout / revocation: the row disappears, the token is unknown from then on.
deleteSession:
DELETE FROM sessions WHERE id = ?;

-- Sliding renewal on read (design D2): read() extends the row it returns.
extendSessionExpiry:
UPDATE sessions SET expires_at = ? WHERE id = ?;

-- Janitor: lazy prune on access plus the background sweep. A sweep never
-- decides requests — read() is the authority (design D2 risk note).
deleteExpiredSessions:
DELETE FROM sessions WHERE expires_at < ?;

countSessions:
SELECT COUNT(*) FROM sessions;
