-- Idempotent on purpose: CREATE TABLE IF NOT EXISTS makes re-running this
-- migration safe on databases where the tables already exist (e.g. an interim
-- image created them via a swallow-on-failure Schema.create() that never
-- wrote user_version). DatabaseFactory.init() infers the effective version
-- from the tables present and may re-run this migration on such databases.
--
-- FK edge policy (enable-db-foreign-keys): accounts.session_id is
-- deliberately plain REFERENCES — NO ACTION, no cascade — a tripwire, not
-- an oversight. Accounts can legitimately outlive their session: the
-- re-authorization merge re-points kept-as-local-copy accounts to the new
-- session row BEFORE deleting the old session. A cascade here would
-- silently destroy the user's kept local copies (plus their balances,
-- via cascade) on any future re-ordering of the merge's statements; NO
-- ACTION turns that bug into a loud transaction failure instead. All
-- deletion paths comply today (children deleted first, or accounts
-- re-pointed first). DatabaseFactory.init() enforces foreign keys per
-- connection (PRAGMA foreign_keys=ON).
CREATE TABLE IF NOT EXISTS eb_sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL UNIQUE,
    aspsp_name TEXT,
    aspsp_country TEXT,
    psu_type TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS accounts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id INTEGER NOT NULL REFERENCES eb_sessions(id),
    iban TEXT,
    uid TEXT,
    currency TEXT,
    name TEXT
);
