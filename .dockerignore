# Build artifacts — copied into the image would waste ~640 MB and slow COPY.
# The copy-only runtime image needs just the pre-built fat JAR, so the
# server build directory is re-included below.
build
**/build
!server/build
!server/build/libs
!server/build/libs/server-all.jar
.gradle
**/.gradle
kotlin-js-store/.cache

# VCS and IDE
.git
.gitignore
.idea
.vscode
*.iml

# Local env / runtime
.env
*.log
node_modules
**/node_modules

# Manual test artifacts
openspec/changes/onboarding-enable-banking/manual-test-plan.md
