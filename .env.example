AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
SERVER_PORT=8080

# Sliding session TTL in minutes — each authenticated request extends the
# server-side session record's expiry by this window (default: 15).
#SESSION_TTL_MINUTES=15

# Flow-record TTL in minutes — the window in which a returning bank redirect
# (OAuth state token) can still be correlated with its flow record
# (default: 60; the single-use bank code remains the actual completion gate).
#STATE_TTL_MINUTES=60
