AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
SERVER_PORT=8080

# SQLite database location, resolved in order:
#   1. the `database.path` system property (highest precedence,
#      e.g. -Ddatabase.path=/tmp/probe.db),
#   2. this DATABASE_PATH env var,
#   3. the local default ./data/bankteller.db (project-relative,
#      auto-created, persistent across restarts).
# The container deployment (docker-compose.yml) sets
# DATABASE_PATH=/data/bankteller.db explicitly for the named volume — this
# section is consumed by docker compose only; a bare `./gradlew :server:run`
# ignores .env and uses the ./data/bankteller.db default (override via the
# exported DATABASE_PATH env var or -Ddatabase.path).
#DATABASE_PATH=

# Sliding session TTL in minutes — each authenticated request extends the
# server-side session record's expiry by this window (default: 15).
#SESSION_TTL_MINUTES=15

# Flow-record TTL in minutes — the window in which a returning bank redirect
# (OAuth state token) can still be correlated with its flow record
# (default: 60; the single-use bank code remains the actual completion gate).
#STATE_TTL_MINUTES=60
