# Test-runner container for wasmJs browser tests (ChromeHeadless via Karma).
#
# Purpose: run ONLY the Karma phase of :app:web:containerWasmJsBrowserTest in
# an isolated Chrome environment — the host builds the test bundle, this
# container executes it. The host's personal browser is never touched, and no
# Gradle/compilation ever happens inside (that path poisoned incremental-
# compilation state; see openspec/changes/build-performance design D3/D5).
#
# Base image: Microsoft's Playwright image bundles Chromium + all browser system
# dependencies (nss, freetype, fonts, mesa, etc.) pre-installed and pinned, plus
# a Node.js runtime — everything the Karma/webpack phase needs. No JDK: the
# container never runs Gradle or javac.
#
# Build:   ./scripts/build-browser-tests-image.sh
# Run:     ./gradlew :app:web:containerWasmJsBrowserTest
FROM mcr.microsoft.com/playwright:v1.49.0-jammy

LABEL org.opencontainers.image.title="BankTeller browser-tests runner"
LABEL org.opencontainers.image.description="Isolated Chrome environment for the Karma phase of :app:web:containerWasmJsBrowserTest"

# Expose Playwright's bundled Chromium at stable paths so Karma's
# chrome-launcher finds it via CHROME_BIN or standard binary lookup.
# The find resolves the version-suffixed directory (e.g. /ms-playwright/chromium-1134-...).
RUN set -e; \
    chromium_path=$(find /ms-playwright -path '*/chrome-linux/chrome' -type f 2>/dev/null | head -1); \
    test -n "$chromium_path"; \
    ln -sf "$chromium_path" /usr/bin/chromium; \
    ln -sf "$chromium_path" /usr/bin/chromium-browser; \
    ln -sf "$chromium_path" /usr/bin/google-chrome
ENV CHROME_BIN=/usr/bin/chromium

WORKDIR /work
